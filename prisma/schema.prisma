// Tripinly database schema. docs/knowledge/03-data-model.md describes the intent;
// this file is the implementation. Spatial columns are declared as
// Unsupported("geography(Point,4326)") and queried with parameterized $queryRaw.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions", "partialIndexes"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis, pg_trgm]
}

// ─── Identity ────────────────────────────────────────────────────────────────

enum UserRole {
  user
  admin
}

enum UserStatus {
  active
  suspended
  deleting
}

enum TripVisibility {
  public
  private
}

enum AuthProvider {
  google
  apple
  /// Local development only (DEV_AUTH_ENABLED); never accepted in production.
  dev
}

enum ConsentDocumentType {
  terms
  privacy
  marketing
}

enum DevicePlatform {
  ios
  android
}

model User {
  id                    String         @id @default(uuid()) @db.Uuid
  /// Null until chosen during onboarding. Stored lowercase; unique.
  username              String?        @unique
  usernameChangedAt     DateTime?
  displayName           String?
  /// Never shown to other users; used for the 16+ check.
  birthDate             DateTime?      @db.Date
  locale                String         @default("en")
  defaultTripVisibility TripVisibility @default(public)
  role                  UserRole       @default(user)
  status                UserStatus     @default(active)
  onboardedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  identities    AuthIdentity[]
  refreshTokens RefreshToken[]
  consents      Consent[]
  devices       Device[]

  ownedTrips     Trip[]       @relation("TripOwner")
  memberships    TripMember[] @relation("TripMemberUser")
  membersAdded   TripMember[] @relation("TripMemberAddedBy")
  invitesCreated TripInvite[]
  markersCreated Marker[]
  photosUploaded Photo[]
  comments       Comment[]
  likes          Like[]
  blocksGiven    Block[]      @relation("Blocker")
  blocksReceived Block[]      @relation("Blocked")

  @@map("users")
}

model AuthIdentity {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @db.Uuid
  provider          AuthProvider
  providerSubject   String
  /// As given by the provider (may be an Apple private relay address). Never an identity key.
  email             String?
  /// AES-256-GCM encrypted; needed to revoke the Apple session on account deletion.
  appleRefreshToken String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  /// SHA-256 of the token; the token itself is never stored.
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  deviceLabel  String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Consent {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  documentType ConsentDocumentType
  version      String
  locale       String
  grantedAt    DateTime?
  withdrawnAt  DateTime?
  createdAt    DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, documentType, createdAt])
  @@map("consents")
}

model LegalDocument {
  id                String              @id @default(uuid()) @db.Uuid
  documentType      ConsentDocumentType
  version           String
  locale            String
  url               String
  publishedAt       DateTime
  /// When true, users who accepted an older version get CONSENT_REQUIRED until they accept this one.
  requiresReconsent Boolean             @default(true)
  createdAt         DateTime            @default(now())

  @@unique([documentType, version, locale])
  @@index([documentType, publishedAt])
  @@map("legal_documents")
}

model Device {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  fcmToken   String         @unique
  platform   DevicePlatform
  locale     String
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

/// Freed usernames stay reserved until releasedAt (30 days after account deletion or a handle change).
model UsernameHold {
  id         String   @id @default(uuid()) @db.Uuid
  username   String   @unique
  releasedAt DateTime
  createdAt  DateTime @default(now())

  @@map("username_holds")
}

// ─── Trips ───────────────────────────────────────────────────────────────────

enum TripRole {
  owner
  editor
}

model Trip {
  id               String         @id @default(uuid()) @db.Uuid
  ownerId          String         @db.Uuid
  title            String
  /// With a start date, endDate = startDate + days - 1 (kept in sync by TripsService).
  startDate        DateTime?      @db.Date
  endDate          DateTime?      @db.Date
  visibility       TripVisibility
  copiedFromTripId String?        @db.Uuid
  likeCount        Int            @default(0)
  copyCount        Int            @default(0)
  /// Set by moderation; hidden trips are visible only to their owner and admins.
  hiddenAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  owner      User         @relation("TripOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  copiedFrom Trip?        @relation("TripCopies", fields: [copiedFromTripId], references: [id], onDelete: SetNull)
  copies     Trip[]       @relation("TripCopies")
  members    TripMember[]
  days       TripDay[]
  invites    TripInvite[]
  markers    Marker[]
  photos     Photo[]
  comments   Comment[]

  @@index([ownerId])
  @@index([visibility, likeCount(sort: Desc)], map: "trips_explore_idx", where: raw("((visibility = 'public'::\"TripVisibility\") AND (\"hiddenAt\" IS NULL))"))
  @@map("trips")
}

model TripMember {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @db.Uuid
  userId    String   @db.Uuid
  role      TripRole
  addedById String?  @db.Uuid
  createdAt DateTime @default(now())

  trip    Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user    User  @relation("TripMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User? @relation("TripMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_members")
}

/// A day's date is derived: trip.startDate + position (none when the trip has no dates).
model TripDay {
  id        String   @id @default(uuid()) @db.Uuid
  tripId    String   @db.Uuid
  /// 0-based; contiguous within a trip.
  position  Int
  createdAt DateTime @default(now())

  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  markers Marker[]

  @@unique([tripId, position])
  @@map("trip_days")
}

model TripInvite {
  id          String    @id @default(uuid()) @db.Uuid
  tripId      String    @db.Uuid
  /// SHA-256 of the link token; the token itself is never stored.
  tokenHash   String    @unique
  createdById String    @db.Uuid
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_invites")
}

// ─── Places and markers ──────────────────────────────────────────────────────

enum PlaceCategory {
  cafe
  restaurant
  bar
  attraction
  museum
  historic
  park
  nature
  landmark
  other
}

enum PlaceSource {
  osm
  user
}

enum OsmType {
  node
  way
  relation
}

/// OSM POIs and user-created places. Never Google data.
model Place {
  id             String                                @id @default(uuid()) @db.Uuid
  name           String
  /// Lowercase, diacritics removed, whitespace collapsed; used for matching and search.
  normalizedName String
  /// Normalized name plus every name:<lang> variant, space-separated; trigram-searched.
  searchText     String                                @default("")
  /// name:<lang> variants from OSM.
  names          Json                                  @default("{}")
  category       PlaceCategory                         @default(other)
  lat            Float
  lng            Float
  /// Generated from lat/lng (see the migration); read-only, for PostGIS queries.
  location       Unsupported("geography(Point,4326)")? @default(dbgenerated("(st_setsrid(st_makepoint(lng, lat), 4326))::geography"))
  source         PlaceSource
  osmType        OsmType?
  osmId          BigInt?
  /// Geofabrik region of the last import that saw this place (osm source only).
  osmRegion      String?
  tags           Json                                  @default("{}")
  isActive       Boolean                               @default(true)
  importedAt     DateTime?
  /// Likes on public markers here + direct place likes (denormalized).
  popularity     Int                                   @default(0)
  createdAt      DateTime                              @default(now())
  updatedAt      DateTime                              @updatedAt

  markers Marker[]

  @@unique([osmType, osmId])
  @@index([location], type: Gist)
  @@index([location], map: "places_location_popular_idx", type: Gist, where: raw("(popularity > 0)"))
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], map: "places_normalized_name_trgm_idx", type: Gin)
  @@index([searchText(ops: raw("gin_trgm_ops"))], map: "places_search_text_trgm_idx", type: Gin)
  @@index([osmRegion])
  @@index([popularity(sort: Desc)])
  @@index([category])
  @@map("places")
}

model Marker {
  id                 String                                @id @default(uuid()) @db.Uuid
  dayId              String                                @db.Uuid
  /// Denormalized from the day for access checks.
  tripId             String                                @db.Uuid
  placeId            String                                @db.Uuid
  name               String
  lat                Float
  lng                Float
  /// Generated from lat/lng (see the migration); read-only, for PostGIS queries.
  location           Unsupported("geography(Point,4326)")? @default(dbgenerated("(st_setsrid(st_makepoint(lng, lat), 4326))::geography"))
  /// Local time "HH:mm", or null.
  time               String?
  /// 0-based; contiguous within a day.
  position           Int
  createdById        String?                               @db.Uuid
  copiedFromMarkerId String?                               @db.Uuid
  /// A ready photo of this marker; the map pin's thumbnail.
  coverPhotoId       String?                               @unique @db.Uuid
  likeCount          Int                                   @default(0)
  commentCount       Int                                   @default(0)
  hiddenAt           DateTime?
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt

  day        TripDay   @relation(fields: [dayId], references: [id], onDelete: Cascade)
  trip       Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  place      Place     @relation(fields: [placeId], references: [id], onDelete: Restrict)
  createdBy  User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  copiedFrom Marker?   @relation("MarkerCopies", fields: [copiedFromMarkerId], references: [id], onDelete: SetNull)
  copies     Marker[]  @relation("MarkerCopies")
  photos     Photo[]   @relation("MarkerPhotos")
  coverPhoto Photo?    @relation("MarkerCover", fields: [coverPhotoId], references: [id], onDelete: SetNull)
  comments   Comment[]

  @@index([dayId, position])
  @@index([tripId])
  @@index([placeId])
  @@index([createdById])
  @@index([location], type: Gist)
  @@map("markers")
}

// ─── Moderation ──────────────────────────────────────────────────────────────

/// Mutual in effect: queries check both directions.
model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

enum OsmImportStatus {
  running
  succeeded
  /// Places were upserted but deactivation was skipped (seen count dropped more than 20%).
  degraded
  failed
}

/// One OSM import of one Geofabrik region (osm-import skill).
model OsmImportRun {
  id          String          @id @default(uuid()) @db.Uuid
  region      String
  status      OsmImportStatus @default(running)
  /// Last-Modified of the downloaded extract.
  extractAt   DateTime?
  seen        Int             @default(0)
  inserted    Int             @default(0)
  updated     Int             @default(0)
  deactivated Int             @default(0)
  /// Short failure reason for operators; never user data.
  error       String?
  startedAt   DateTime        @default(now())
  finishedAt  DateTime?

  @@index([region, startedAt(sort: Desc)])
  @@map("osm_import_runs")
}

enum PhotoStatus {
  pending_upload
  processing
  ready
  failed
}

/// Storage keys derive from the id: photos/{id}/original, thumb.webp, display.webp.
model Photo {
  id         String      @id @default(uuid()) @db.Uuid
  markerId   String      @db.Uuid
  /// Denormalized from the marker for access checks and cleanup.
  tripId     String      @db.Uuid
  /// Restrict: account deletion removes a user's photos (and their files) first.
  uploaderId String      @db.Uuid
  status     PhotoStatus @default(pending_upload)
  /// Declared at upload: image/jpeg, image/png or image/webp.
  mimeType   String
  /// Declared size of the original upload.
  bytes      Int
  width      Int?
  height     Int?
  /// 0-based gallery order within the marker.
  position   Int
  likeCount  Int         @default(0)
  hiddenAt   DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  marker   Marker  @relation("MarkerPhotos", fields: [markerId], references: [id], onDelete: Cascade)
  trip     Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  uploader User    @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  coverOf  Marker? @relation("MarkerCover")

  @@index([markerId, position])
  @@index([tripId])
  @@index([uploaderId])
  @@index([status, updatedAt])
  @@map("photos")
}

// ─── Social ──────────────────────────────────────────────────────────────────

/// Comments on markers (flat list, plain text).
model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  markerId  String    @db.Uuid
  /// Denormalized from the marker for access checks.
  tripId    String    @db.Uuid
  authorId  String    @db.Uuid
  body      String
  likeCount Int       @default(0)
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  marker Marker @relation(fields: [markerId], references: [id], onDelete: Cascade)
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([markerId, createdAt, id])
  @@index([tripId])
  @@index([authorId])
  @@map("comments")
}

enum LikeTargetType {
  trip
  marker
  photo
  comment
  place
}

/// One like per user and target. Likes on a deleted trip, marker, photo or
/// comment are removed by database triggers (see the social migration).
model Like {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  targetType LikeTargetType
  targetId   String         @db.Uuid
  createdAt  DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("likes")
}
