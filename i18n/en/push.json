{
  "someone": "Someone",
  "comment_on_marker": {
    "title": "{actor} commented on {marker}",
    "body": "{excerpt}"
  },
  "comment_reply": {
    "title": "{actor} replied on {marker}",
    "body": "{excerpt}"
  },
  "comment_mention": {
    "title": "{actor} mentioned you on {marker}",
    "body": "{excerpt}"
  },
  "added_to_trip": {
    "title": "{actor} added you to {trip}",
    "body": "Open it to plan together."
  },
  "join_requested": {
    "title": "{actor} wants to join {trip}",
    "body": "Tap to accept or decline."
  },
  "trip_changed_by_collaborator": {
    "title": "Changes in {trip}",
    "places_added": {
      "one": "{actor} added a place",
      "other": "{actor} added {count} places"
    },
    "one_actor": {
      "one": "{actor} made a change",
      "other": "{actor} made {count} changes"
    },
    "many_actors": {
      "one": "{actor} and others made a change",
      "other": "{actor} and others made {count} changes"
    }
  },
  "likes_grouped": {
    "title": "New likes",
    "in_trip": {
      "one": "{actor} liked your post in {trip}",
      "other": "{count} people liked your posts in {trip}"
    },
    "anywhere": {
      "one": "{actor} liked your post",
      "other": "{count} people liked your posts"
    }
  },
  "join_accepted": {
    "title": "{actor} accepted your request",
    "body": "You're in {trip} now."
  },
  "liked": {
    "trip": {
      "title": "{actor} liked your trip",
      "body": "{trip}",
      "title_others": {
        "one": "{actor} and 1 other liked your trip",
        "other": "{actor} and {count} others liked your trip"
      }
    },
    "photo": {
      "title": "{actor} liked your photo",
      "body": "{marker} · {trip}",
      "title_others": {
        "one": "{actor} and 1 other liked your photo",
        "other": "{actor} and {count} others liked your photo"
      },
      "body_place": "{marker}"
    },
    "comment": {
      "title": "{actor} liked your comment",
      "body": "\"{excerpt}\" on {marker}",
      "title_others": {
        "one": "{actor} and 1 other liked your comment",
        "other": "{actor} and {count} others liked your comment"
      }
    }
  },
  "followed": {
    "title": "{actor} followed you",
    "body": "Follow back to become friends."
  },
  "became_friends": {
    "title": "You and {actor} are now friends",
    "body": "You can add each other to trips."
  },
  "trip_saved": {
    "title": "{actor} saved your trip",
    "body": "{trip}"
  },
  "place_hot": {
    "title": "{place} is getting hot",
    "body": {
      "one": "{count} person marked your spot hot. Nice find!",
      "other": "{count} people marked your spot hot. Nice find!"
    }
  },
  "join_declined": {
    "title": "{actor} declined your request",
    "body": "You can't join {trip}."
  },
  "removed_from_trip": {
    "title": "{actor} removed you from {trip}",
    "body": "You can't see the trip any more."
  }
}
