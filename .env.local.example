# Local development defaults: `cp .env.local.example .env`. Never put real secrets here.
NODE_ENV=development
PORT=3000
APP_LOG_LEVEL=debug
DATABASE_URL=postgresql://tripinly:tripinly@localhost:5432/tripinly
REDIS_URL=redis://localhost:6379

# Auth. Generate secrets with: openssl rand -base64 48 / openssl rand -base64 32
APP_JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
APP_ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=
# Comma-separated Google OAuth client IDs (Android, iOS). Google sign-in is disabled when empty.
APP_GOOGLE_CLIENT_IDS=
# Apple sign-in: set all four or none.
APP_APPLE_BUNDLE_ID=
APP_APPLE_TEAM_ID=
APP_APPLE_KEY_ID=
APP_APPLE_PRIVATE_KEY=
# POST /v1/auth/dev signs in without Google/Apple. Local development only.
APP_DEPLOY_ENV=local
APP_DEV_AUTH_ENABLED=true
# Required on staging (32+ chars); clients send it as X-Dev-Auth-Secret
APP_DEV_AUTH_SECRET=

# Base for invite/share links; a https domain once App Links are set up.
APP_LINK_BASE_URL=tripinly://app

# Photo storage: Cloudflare R2 in staging/production; VersityGW (S3 stand-in) from docker-compose locally.
# Unset = photo endpoints answer 503.
# APP_R2_ACCOUNT_ID=
APP_R2_ENDPOINT=http://localhost:7070
APP_R2_ACCESS_KEY_ID=tripinly
APP_R2_SECRET_ACCESS_KEY=tripinly-secret
APP_R2_BUCKET=tripinly-photos

# Places (docs/knowledge/10-maps-places-routing.md)
APP_PHOTON_BASE_URL=https://photon.komoot.io
# Routing (openrouteservice). Free key from https://openrouteservice.org/dev/#/signup;
# without one, routes are straight lines (degraded: true) and best route uses straight-line distance.
APP_ORS_API_KEY=
APP_ORS_BASE_URL=https://api.heigit.org/openrouteservice
APP_OSM_IMPORT_REGIONS=europe/austria,europe/hungary
# The worker downloads and imports the regions monthly only when true.
APP_OSM_IMPORT_ENABLED=false
APP_OSM_IMPORT_CRON=0 3 2 * *
APP_GEOFABRIK_BASE_URL=https://download.geofabrik.de
# APP_OSM_IMPORT_TMP_DIR=/tmp

# Push notifications (FCM). The service account JSON from Firebase console →
# Project settings → Service accounts → Generate new private key, pasted raw or
# base64-encoded. Unset = no pushes; in-app notifications still work.
APP_FIREBASE_SERVICE_ACCOUNT_JSON=
# Transactional email (Resend). Unset = emails are skipped with a warning.
APP_RESEND_API_KEY=
APP_EMAIL_FROM=
# RevenueCat secret API key. Account deletion deletes the RevenueCat customer;
# skipped with a warning while unset.
APP_REVENUECAT_API_KEY=
