# Every environment variable the api and worker read, with empty values.
# Values are empty on purpose: Railway imports this file into new services, and
# local defaults or example secrets must never reach a deployed environment.
# Local development: `cp .env.local.example .env`. Deployed values: docs/deploy/railway-staging.md.
# Empty values count as unset.
NODE_ENV=
PORT=
LOG_LEVEL=
DATABASE_URL=
REDIS_URL=
# Years to keep consent proof after account deletion (default 5)
CONSENT_PROOF_RETENTION_YEARS=
APP_PLACES_REFRESH_SECONDS=
APP_PHOTO_MAX_EDGE_PX=
APP_PHOTO_JPEG_QUALITY=
APP_PHOTO_PARALLEL_UPLOADS=
# Place prominence from which map pins are drawn largest (default 95) and middle-sized (default 60).
APP_PIN_LARGE_MIN_PROMINENCE=
APP_PIN_MEDIUM_MIN_PROMINENCE=
# Most place pins the app draws on the map at once (default 150).
APP_MAP_MAX_PINS=
# Below this camera zoom place pins are drawn as dots (default 14, 0-22).
APP_PIN_DOT_BELOW_ZOOM=
# Most people in one trip, owner included (default 50)
APP_TRIP_MAX_MEMBERS=
# Worker: the same notification again (like, unlike, like) within this many seconds is dropped (default 5, 0-300, 0 = off)
NOTIFICATION_REPEAT_COOLDOWN_SECONDS=

# Auth. Generate secrets with: openssl rand -base64 48 / openssl rand -base64 32
JWT_ACCESS_SECRET=
ENCRYPTION_KEY=
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_DAYS=
# Comma-separated Google OAuth client IDs (Android, iOS). Google sign-in is disabled when empty.
GOOGLE_CLIENT_IDS=
# Apple sign-in: set all four or none.
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# local | staging | production. POST /v1/auth/dev signs in without Google/Apple: local and staging only.
DEPLOY_ENV=
DEV_AUTH_ENABLED=
# Required on staging (32+ chars); clients send it as X-Dev-Auth-Secret
DEV_AUTH_SECRET=
# Dev sign-in accounts get every premium feature (needs DEV_AUTH_ENABLED)
DEV_ACCOUNTS_PRO=

# Base for invite/share links; a https domain once App Links are set up.
APP_LINK_BASE_URL=

# Photo storage: Cloudflare R2 in staging/production; VersityGW (S3 stand-in) from docker-compose locally.
# Unset = photo endpoints answer 503.
# R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Places (docs/knowledge/10-maps-places-routing.md)
PHOTON_BASE_URL=
# People outside a trip who must like a photo before it represents a place (default 2).
APP_PLACE_PHOTO_MIN_OUTSIDE_LIKES=
# Likes a place needs to rank on the map by its likes rather than by prominence (default 1).
APP_PLACE_RANK_MIN_HOT_COUNT=
# Place photos one person may add in 24 hours (default 20).
APP_PLACE_PHOTO_DAILY_LIMIT=
# Explore's Nearby filter radius in km (default 50)
APP_EXPLORE_NEARBY_RADIUS_KM=
# Routing (openrouteservice). Free key from https://openrouteservice.org/dev/#/signup;
# without one, routes are straight lines (degraded: true) and best route uses straight-line distance.
ORS_API_KEY=
ORS_BASE_URL=
ORS_DIRECTIONS_DAILY_QUOTA=
ORS_MATRIX_DAILY_QUOTA=
OSM_IMPORT_REGIONS=
# The worker downloads and imports the regions monthly only when true.
OSM_IMPORT_ENABLED=
OSM_IMPORT_CRON=
GEOFABRIK_BASE_URL=
QRANK_URL=
# The worker copies Wikimedia Commons images of places into storage only when true.
PLACE_IMAGES_SYNC_ENABLED=
# OSM_IMPORT_TMP_DIR=

# Push notifications (FCM). The service account JSON from Firebase console →
# Project settings → Service accounts → Generate new private key, pasted raw or
# base64-encoded. Unset = no pushes; in-app notifications still work.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Transactional email (Resend). Unset = emails are skipped with a warning.
RESEND_API_KEY=
EMAIL_FROM=
# RevenueCat secret API key. Account deletion deletes the RevenueCat customer;
# skipped with a warning while unset.
REVENUECAT_API_KEY=
